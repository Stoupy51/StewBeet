    "html": "<pre class=\"shiki dark-plus\" style=\"background-color:#1E1E1E;color:#D4D4D4\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#4EC9B0\">Block</span><span style=\"color:#D4D4D4\">(</span></span>\n<span class=\"line\"><span style=\"color:#9CDCFE\">    id</span><span style=\"color:#D4D4D4\">=</span><span style=\"color:#CE9178\">\"life_crystal_block\"</span><span style=\"color:#D4D4D4\">,</span></span>\n<span class=\"line\"><span style=\"color:#9CDCFE\">    vanilla_block</span><span style=\"color:#D4D4D4\">=</span><span style=\"color:#4EC9B0\">VanillaBlock</span><span style=\"color:#D4D4D4\">(</span><span style=\"color:#9CDCFE\">id</span><span style=\"color:#D4D4D4\">=</span><span style=\"color:#CE9178\">\"minecraft:glass\"</span><span style=\"color:#D4D4D4\">),</span></span>\n<span class=\"line\"><span style=\"color:#9CDCFE\">    manual_category</span><span style=\"color:#D4D4D4\">=</span><span style=\"color:#CE9178\">\"equipment\"</span><span style=\"color:#D4D4D4\">,</span></span>\n<span class=\"line\"><span style=\"color:#9CDCFE\">    components</span><span style=\"color:#D4D4D4\">={</span></span>\n<span class=\"line\"><span style=\"color:#CE9178\">        \"item_name\"</span><span style=\"color:#D4D4D4\">: {</span><span style=\"color:#CE9178\">\"text\"</span><span style=\"color:#D4D4D4\">: </span><span style=\"color:#CE9178\">\"Life Crystal Block\"</span><span style=\"color:#D4D4D4\">},</span></span>\n<span class=\"line\"><span style=\"color:#CE9178\">        \"lore\"</span><span style=\"color:#D4D4D4\">: [{</span><span style=\"color:#CE9178\">\"text\"</span><span style=\"color:#D4D4D4\">: </span><span style=\"color:#CE9178\">\"Break it to get the crystal back\"</span><span style=\"color:#D4D4D4\">}],</span></span>\n<span class=\"line\"><span style=\"color:#D4D4D4\">    },</span></span>\n<span class=\"line\"><span style=\"color:#6A9955\">    # Broken without Silk Touch, it hands the crystal back</span></span>\n<span class=\"line\"><span