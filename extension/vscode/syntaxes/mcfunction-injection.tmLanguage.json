          "name": "meta.embedded.block.mcfunction.stewbeet",
          "begin": "((?:write_function|write_versioned_function)\\s*\\([^,\\n]+?,\\s*)(f?)(\\\"\\\"\\\")",
          "beginCaptures": {
            "1": {
              "name": "meta.function-call.stewbeet"
            },
            "2": {
              "name": "string.affix.python"
            },
            "3": {
              "name": "punctuation.definition.string.begin.python"
            }
          },
          "end": "(\\\"\\\"\\\")(\\s*(?:[^)\\n]*)?\\))?",
